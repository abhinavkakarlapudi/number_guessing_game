#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    int number, guess, tries = 0;
    srand(time(0));
    number = rand() % 101;
    printf("Welcome to the Number Guessing Game!\n");
    printf("I have chosen a number between 0 and 100.\n");
    do {
        printf("Enter your guess: ");
        scanf("%d", &guess);
        tries++;
        if (guess > number)
            printf("High! Try again.\n");
        else if (guess < number)
            printf("Low! Try again.\n");
        else
            printf("You got it! The number was %d. You guessed it in %d tries.\n", number, tries);
    } while (guess != number);
    return 0;
}
